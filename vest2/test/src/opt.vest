msg = {
  const a: u8 = 1,
  const b: [u8; 2] = [1, 2],
}

// Secure
optmsg = Option<msg>

// msg2(@x: u8) = [u8; @x]

// Insecure
// optmsg = {
//   @x: u8,
//   y: Option<msg2(@x)>,
// }

a = wrap(u8 = 1, u8 = 2, [u8; 10], u8 = 3)

b = {
  x: [u8; 10],
  y: wrap(u16 = 0xffff, a, u8 = 1),
}

tagged_mix = {
  x: Option<wrap(u8 = 10, [u8; 1])>,
  y: Vec<wrap(u8 = 11, [u8; 2])>,
  z: Option<wrap(u8 = 12, [u8; 3])>,
  w: Vec<wrap(u8 = 13, [u8; 4])>,
}
