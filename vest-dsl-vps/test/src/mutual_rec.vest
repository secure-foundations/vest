chain_a(@tag: u8) = choose(@tag) {
  0 => u8 | 1..10,
  _ => {
    @len: u8,
    payload: [u8; @len],
    @next_tag: u8,
    tail: chain_b(@next_tag),
  },
}

chain_b(@tag: u8) = choose(@tag) {
  0 => u16 | 256..,
  _ => {
    payload: u32,
    @next_tag: u8,
    tail: chain_a(@next_tag),
  },
}
